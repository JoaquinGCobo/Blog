{{- $pctx := . -}}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end -}}
{{- $pages := slice -}}
{{- if eq .Kind "home" -}}
  {{- $pages = where site.RegularPages "Section" "posts" -}}
{{- else if in (slice "section" "taxonomy" "term") .Kind -}}
  {{- $pages = .RegularPages -}}
{{- else -}}
  {{- $pages = .Pages -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0">
  <channel>
    {{- $pageTitle := partial "localized-title.html" . -}}
    <title>{{ if eq $pageTitle site.Title }}{{ site.Title }}{{ else }}{{ $pageTitle }} | {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale | default site.Language.Lang | default "es-ES" }}</language>
    {{- range first 20 (sort $pages "Date" "desc") }}
      <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        <guid>{{ .Permalink }}</guid>
        <description>{{ .Summary | plainify | htmlEscape }}</description>
        <author>{{ .Params.author | default site.Params.author }}</author>
        {{- range .Params.tags }}
          <category>{{ . }}</category>
        {{- end }}
      </item>
    {{- end }}
  </channel>
</rss>
